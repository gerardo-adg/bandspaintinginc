---
import Base from '../../layouts/Base.astro';
import Cards from '../../components/Cards.astro';
import projects from '../../projects.json';
import { services, servicePath } from '../../service-pages';

export function getStaticPaths() {
  return services.map(service => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const title = service.name + ' in Sacramento, CA';
const estimate = '/contact/?service=' + service.slug;
const examples = service.projects.flatMap(id => projects.filter(project => project.slug.startsWith(id + '-')));
const [featured] = examples;
const related = services.filter(item => service.related.includes(item.slug));
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
  { name: service.name, path: servicePath(service.slug) },
];
---
<Base title={title} description={service.intro} seo={{ service, breadcrumbs, image: featured?.image }}>
  <section class="section service-intro">
    <div class:list={['service-layout', { 'with-photo': featured }]}>
      <div>
        <p class="eyebrow"><a href="/services/">Painting services</a></p>
        <h1>{title}</h1>
        <p class="lead">{service.intro}</p>
        <a class="btn" href={estimate}>Request a free estimate</a>
      </div>
      {featured && (
        <figure class="service-photo">
          <img src={featured.image} alt={featured.title} fetchpriority="high" />
          <figcaption><a class="textlink" href={'/projects/' + featured.slug + '/'}>{featured.title}</a></figcaption>
        </figure>
      )}
    </div>
  </section>
  <section class="section tinted service-details" aria-label={'Planning your ' + service.name.toLowerCase() + ' project'}>
    {service.sections.map(([heading, copy]) => (
      <div><h2>{heading}</h2><p>{copy}</p></div>
    ))}
  </section>
  {examples.length > 1 && (
    <section class="section">
      <h2>More of our work</h2>
      <Cards items={examples.slice(1)} />
    </section>
  )}
  <section class="section service-details">
    <div>
      <h2>Get an estimate</h2>
      <p>Send us your project address and contact details so we can follow up.</p>
      <a class="btn" href={estimate}>Request a free estimate</a>
    </div>
    <div>
      <h2>Related services</h2>
      <ul>
        {related.map(item => <li><a class="textlink" href={servicePath(item.slug)}>{item.name}</a></li>)}
      </ul>
    </div>
  </section>
</Base>
<style>
  .service-intro h1 { font-size: clamp(3rem, 5.6vw, 5.65rem); max-width: 15ch; }
  .service-layout.with-photo, .service-details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2rem, 5vw, 5rem); }
  .service-layout { align-items: center; }
  .service-photo img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 4px; }
  figcaption { margin-top: .75rem; }
  .service-details h2 { font-size: clamp(1.85rem, 3vw, 3rem); line-height: 1.1; }
  .service-details p { color: var(--muted); line-height: 1.65; max-width: 40rem; }
  ul { padding: 0; list-style: none; }
  li + li { margin-top: .85rem; }
  @media (max-width: 760px) {
    .service-layout.with-photo, .service-details { grid-template-columns: 1fr; }
  }
</style>
