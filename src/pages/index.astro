---
import Base from '../layouts/Base.astro';
import Cards from '../components/Cards.astro';
import Reviews from '../components/Reviews.astro';
import projects from '../projects.json';
import { services, servicePath } from '../service-pages';
const project=(id:string)=>projects.find(p=>p.slug.startsWith(id))!;
---
<Base title="Painters in Sacramento, CA" description="B&S Painting is a father-and-son painting company serving Sacramento. Explore interior and exterior painting, cabinet painting, and commercial services. Request a free estimate.">
<section class="hero"><div class="intro"><p class="eyebrow"><i></i> Greater Sacramento, CA</p><h1>A fresh coat.<br/><em>A whole new <br/>feeling.</em></h1><p class="lead">Interior and exterior painting by a Sacramento father-and-son team.<span class="desktop-lead"> From the cabinets in your kitchen to the siding on your home.</span></p><div class="actions"><a class="btn" href="/contact/">Request a free estimate</a><a class="textlink" href="/projects/"><span class="desktop-work-label">Explore our work</span><span class="mobile-work-label">View our work</span></a></div></div>
<figure class="feature">
  <picture>
    <source media="(max-width: 760px)" srcset="/images/mobile-exterior-hero.webp" />
    <img fetchpriority="high" src={project('7141150').image} alt="" />
  </picture>
  <figcaption><span>El Dorado Hills</span>Interior painting</figcaption>
</figure></section>
<section class="band"><span class="desktop-trust">Family owned &amp; operated</span><span class="desktop-trust">Licensed &amp; insured</span><a class="award-link" href="/images/businessrate-sacramento-2025.webp" aria-label="View the BusinessRate Best of Sacramento 2025 award plaque">
  <img src="/images/businessrate-sacramento-2025.webp" width="640" height="759" alt="" />
  <span><strong>Best of Sacramento 2025</strong><small>BusinessRate · Painter</small></span>
</a></section>
<section class="section"><p class="eyebrow">The portfolio</p><div class="row"><h2>Work around town.</h2><a class="textlink" href="/projects/">View all projects</a></div><Cards items={['7141572','7141150','elk-grove-stucco-repaint'].map(project)}/></section>
<Reviews />
<section id="services" class="section tinted">
  <p class="eyebrow">Painting services</p>
  <div class="servicegrid">
    <div>
      <h2>Painting for homes<br />and businesses.</h2>
      <p><a class="textlink" href="/services/">View all painting services</a></p>
    </div>
    <ul class="home-services">
      {services.map(service => <li><a href={servicePath(service.slug)}>{service.name}</a></li>)}
    </ul>
  </div>
</section>
<section class="section story"><div><p class="eyebrow">Meet B&amp;S</p><h2>Father and son.<br/><em>On the same crew.</em></h2></div><div><p>Bryan was 13 when he started spending his summers painting with his dad, Benito. In 2022, they put their names on a company of their own.</p><a class="textlink" href="/about/">Meet the family</a></div></section>
</Base>

<style>
  .home-services {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .home-services a { display: block; padding: .75rem 0; border-bottom: 1px solid var(--rule); }
  .home-services a:hover { text-decoration: underline; }
  .award-link {
    display: flex;
    align-items: center;
    gap: .625rem;
    text-align: left;
  }
  .award-link img {
    display: block;
    width: 44px;
    height: auto;
    border: 1px solid #c5a45c;
    border-radius: 3px;
  }
  .award-link small {
    display: block;
    margin-top: .25rem;
    font-size: .82rem;
    color: #e8d8b5;
  }
  .award-link:hover strong { text-decoration: underline; }
  .mobile-work-label { display: none; }
  @media (max-width: 760px) {
    .hero {
      isolation: isolate;
      min-height: calc(clamp(27rem, 120vw, 34rem) + 3rem);
      background: #242321;
      color: #fff;
    }
    .hero .intro, .hero .feature { grid-area: 1 / 1; }
    .hero .feature { min-height: 0; }
    .hero .feature img { object-position: 90% top; }
    .hero .feature::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgb(0 0 0 / 43%), rgb(0 0 0 / 66%) 57%, rgb(0 0 0 / 72%));
    }
    .hero .feature figcaption { display: none; }
    .hero .intro {
      position: relative;
      z-index: 1;
      width: 100%;
      padding: 7.5rem 1.3rem 2rem;
      text-align: center;
      text-shadow: 0 2px 6px #0006;
    }
    .hero .intro h1 { font-size: clamp(2.7rem, 11vw, 4rem); }
    .hero .intro h1 em { font-style: normal; }
    .hero .intro h1 em br { display: initial; }
    .hero .lead { margin: .75rem auto 0; max-width: 29ch; color: #fff; font-size: 1rem; line-height: 1.45; }
    .hero .desktop-lead { display: none; }
    .hero .actions { flex-direction: column; gap: .55rem; margin-top: 1.35rem; }
    .hero .btn {
      width: min(100%, 19rem);
      border-radius: .6rem;
      background: #0069b0;
      color: #fff;
      text-shadow: none;
    }
    .hero .btn:hover { background: #00558f; }
    .hero .textlink { border: 0; display: grid; place-items: center; min-height: 44px; padding: 0; text-decoration: underline; text-underline-offset: .25rem; }
    .desktop-work-label { display: none; }
    .mobile-work-label { display: inline; }
    .hero a:focus-visible { outline-color: #fff; }
    .hero .eyebrow { color: #9ed9ff; justify-content: center; text-align: center; margin-bottom: .8rem; }
    .hero .eyebrow i { display: none; }
    .band { justify-content: center; padding-block: 1rem; }
    .desktop-trust { display: none; }
  }
</style>
