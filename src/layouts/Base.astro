---
import '../style.css';
import ServicesMenu from '../components/ServicesMenu.astro';
import { absoluteUrl, structuredData, type PageSeo } from '../seo';
const navigation = [{ href: "/projects/", label: "Our work" }, { href: "/about/", label: "About" }];
interface Props {
  title: string;
  description?: string;
  seo?: PageSeo;
}
const { title, description = 'Residential and commercial painting in Greater Sacramento. Explore B&S Painting projects and request a free estimate.', seo = {} } = Astro.props;
const path = Astro.url.pathname.replace(/\/?$/, '/');
const canonical = absoluteUrl(path);
const fullTitle = title + ' | B&S Painting Inc.';
const socialImage = absoluteUrl(seo.image ?? '/images/7141150-el-dorado-hills-interior-work.webp');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="B&S Painting Inc." />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={socialImage} />
  <script type="application/ld+json" set:html={structuredData(path, fullTitle, description, seo)} />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header><a class="brand" href="/" aria-label="B and S Painting home"><img src="/images/bs-painting-logo.webp" alt="B&amp;S Painting Inc." width="420" height="169" style="width:clamp(112px,14vw,152px);height:auto;display:block" /></a>
<nav class="desktop-nav" aria-label="Main">
  <ServicesMenu />
  {navigation.map(({ href, label }) => <a href={href}>{label}</a>)}
</nav>
<a class="btn headbtn" href="/contact/">Free estimate</a>
<details class="mobile-menu">
  <summary aria-label="Menu"><span class="menu-icon" aria-hidden="true"></span></summary>
  <nav aria-label="Mobile menu">
    <ServicesMenu />
    {navigation.map(({ href, label }) => <a href={href}>{label}</a>)}
  </nav>
</details></header>
<main id="main"><slot/></main>
<footer>
  <div><b>B&amp;S Painting Inc.</b><p>Sacramento, California · License #1097013</p></div>
  <div><a href="tel:+19168689188">(916) 868-9188</a><br/><a href="mailto:Bryana@bspaintinc.com">Bryana@bspaintinc.com</a></div>
  <nav class="footer-links" aria-label="Legal">
    <a href="/privacy-policy/">Privacy Policy</a>
    <a href="/terms-and-conditions/">Terms and Conditions</a>
  </nav>
</footer>
</body></html>

<style>
  header { position: relative; z-index: 2; }
  .footer-links { align-items: flex-start; gap: .4rem 1rem; flex-wrap: wrap; }
  .footer-links a, :global(.legal-copy a) { text-decoration: underline; text-underline-offset: .2em; }
  :global(.legal-copy) { max-width: 72ch; margin-inline: auto; line-height: 1.65; }
  :global(.legal-copy h1) { font-size: clamp(2.7rem, 6vw, 5rem); }
  :global(.legal-copy h2) { font: 1.65rem/1.2 Georgia, serif; margin-top: 2rem; }
  .mobile-menu { display: none; }
  @media (max-width: 760px) {
    header { flex-wrap: nowrap; gap: .5rem; }
    .desktop-nav { display: none; }
    .mobile-menu { display: block; padding: 0; border: 0; }
    .mobile-menu summary {
      display: grid; place-items: center; width: 44px; height: 44px;
      color: var(--navy); cursor: pointer; list-style: none;
    }
    .mobile-menu summary::-webkit-details-marker { display: none; }
    .menu-icon, .menu-icon::before, .menu-icon::after {
      display: block; width: 22px; height: 2px; background: currentColor;
    }
    .menu-icon { position: relative; }
    .menu-icon::before, .menu-icon::after { content: ""; position: absolute; }
    .menu-icon::before { top: -7px; }
    .menu-icon::after { top: 7px; }
    .mobile-menu[open] .menu-icon { background: transparent; }
    .mobile-menu[open] .menu-icon::before { top: 0; transform: rotate(45deg); }
    .mobile-menu[open] .menu-icon::after { top: 0; transform: rotate(-45deg); }
    .mobile-menu nav {
      position: absolute; top: 100%; inset-inline: 0; display: grid; gap: 0;
      justify-content: stretch; padding: .4rem 1.3rem .8rem;
      max-height: calc(100dvh - 6rem); overflow-y: auto;
      background: var(--paper); border-bottom: 1px solid var(--rule);
      box-shadow: 0 12px 16px #142b4314;
    }
    .mobile-menu nav > a { padding: .9rem 0; }
    .mobile-menu nav > a + a { border-top: 1px solid var(--rule); }
  }
</style>
<script>
  const mobileMenu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  const desktopServices = document.querySelector<HTMLDetailsElement>('.desktop-nav [data-services-menu]');
  const mobileServices = mobileMenu?.querySelector<HTMLDetailsElement>('[data-services-menu]');
  const menus = [mobileServices, mobileMenu, desktopServices].filter(menu => menu !== undefined && menu !== null);

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const clickedLink = event.target.closest('a');
    for (const menu of menus) {
      if (!menu.contains(event.target) || clickedLink) menu.open = false;
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const openMenu = menus.find(menu => menu.open);
    if (openMenu) {
      openMenu.open = false;
      openMenu.querySelector('summary')?.focus();
    }
  });

  mobileMenu?.addEventListener('toggle', () => {
    if (!mobileMenu.open && mobileServices) mobileServices.open = false;
  });

  matchMedia('(max-width: 760px)').addEventListener('change', () => {
    for (const menu of menus) menu.open = false;
  });
</script>
