---
import { services, servicePath } from '../service-pages';
const currentPath = Astro.url.pathname.replace(/\/?$/, '/');
---
<details class="services-menu" data-services-menu>
  <summary>Services</summary>
  <div class="services-panel">
    <a class="all-services" href="/services/" aria-current={currentPath === '/services/' ? 'page' : undefined}>All services</a>
    <ul>
      {services.map(({ name, slug }) => (
        <li><a href={servicePath(slug)} aria-current={currentPath === servicePath(slug) ? 'page' : undefined}>{name}</a></li>
      ))}
    </ul>
  </div>
</details>
<style>
  .services-menu {
    position: relative;
    padding: 0;
    border: 0;
  }
  summary {
    display: flex;
    align-items: center;
    gap: .55rem;
    min-height: 44px;
    list-style: none;
    font: 650 .94rem Arial, Helvetica, sans-serif;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: '';
    width: .45rem;
    height: .45rem;
    border: solid currentColor;
    border-width: 0 2px 2px 0;
    transform: translateY(-.14rem) rotate(45deg);
  }
  details[open] > summary::after { transform: translateY(.1rem) rotate(225deg); }
  .services-panel {
    position: absolute;
    top: 100%;
    left: -.75rem;
    width: min(27rem, 48vw);
    padding: .6rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--paper);
    box-shadow: 0 12px 32px #142b4324;
  }
  ul { display: grid; grid-template-columns: 1fr 1fr; margin: 0; padding: .25rem 0 0; list-style: none; }
  .services-menu a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: .55rem .65rem;
  }
  .all-services { border-bottom: 1px solid var(--rule); }
  a:hover, a[aria-current="page"] { color: var(--brand-blue); }
  @media (max-width: 760px) {
    .services-menu { border-bottom: 1px solid var(--rule); }
    summary { justify-content: space-between; padding: .9rem 0; }
    .services-panel { position: static; width: auto; padding: 0 0 .4rem .6rem; border: 0; box-shadow: none; }
    ul { grid-template-columns: 1fr; }
  }
</style>
